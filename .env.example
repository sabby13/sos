# Copy to .env and fill in whichever provider(s) you use.
# OpenJarvis reads .env from the current directory and from ~/.openjarvis/.env

# --- Groq (fast + cheap; great for whisper-large-v3-turbo transcription) ---
GROQ_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Optional overrides (these beat config.yaml, and are beaten by CLI flags) ---
# OPENJARVIS_LLM_PROVIDER=groq
# OPENJARVIS_LLM_MODEL=openai/gpt-oss-120b   # run `jarvis models` to see your options
# OPENJARVIS_STT_PROVIDER=groq
# OPENJARVIS_TTS_PROVIDER=edge   # edge | system | openai | groq | none
# OPENJARVIS_TTS_VOICE=en-GB-SoniaNeural
# OPENJARVIS_SAFETY_MODE=tiered
# OPENJARVIS_LOG_LEVEL=INFO
